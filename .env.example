# Supabase Dashboard > Project settings > API. Never use a secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact trusted origin; register /auth/callback in Supabase redirect URLs.
APP_ORIGIN=http://localhost:3000
# Public slug used to load the current launch challenge.
PROOVIT_CHALLENGE_SLUG=launch-31
# Local-only one-click preview route. Never enable in production.
PROOVIT_LOCAL_PREVIEW=false
# Explicit opt-in: isolated UI fixtures, never real participation or score data.
ENABLE_UI_PREVIEW=false
# Server only. Never use NEXT_PUBLIC_ or commit a real value. Required for Camera Proof storage.
SUPABASE_SECRET_KEY=
