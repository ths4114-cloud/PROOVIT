  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests *.ts *.mjs *.json .github/workflows/ci.yml",
    "format:check": "prettier --check src tests *.ts *.mjs *.json .github/workflows/ci.yml",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test:e2e": "playwright test"
  }
