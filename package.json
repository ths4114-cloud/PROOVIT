{
  "name": "proovit",
  "version": "0.1.0",
  "description": "PROOVIT은 사용자의 목표를 검증 가능한 미션으로 전환하고, 실행 결과를 Proof로 확인해 Score와 Ranking에 반영하는 Goal Competition 서비스입니다.",
  "keywords": [],
  "author": "",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:participant": "playwright test --config=playwright.participant.config.ts",
    "format": "prettier --write src tests *.ts *.mjs *.json .github/workflows/ci.yml",
    "format:check": "prettier --check src tests *.ts *.mjs *.json .github/workflows/ci.yml",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test:concurrency": "node tests/postgres-concurrency.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "pg": "8.23.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
